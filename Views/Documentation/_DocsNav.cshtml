                    <span class="docs-nav-copy"><b>Quickstart</b><small>Make your first request</small></span>
                    <i class="docs-nav-arrow" aria-hidden="true">&rsaquo;</i>
                </a>
                <a class="docs-nav-link @(isAuthentication ? "active" : "")" href="@Url.Action("Authentication", "Documentation")" aria-current="@(isAuthentication ? "page" : null)">
                    <span class="docs-nav-icon icon-violet" aria-hidden="true"><svg><use href="#icon-key"></use></svg></span>
                    <span class="docs-nav-copy"><b>Authentication</b><small>Keys, scopes, and security</small></span>
                    <i class="docs-nav-arrow" aria-hidden="true">&rsaquo;</i>
