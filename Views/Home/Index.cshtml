@{ ViewBag.Title = "Dealer APIs and digital solutions"; ViewBag.BodyClass = "home-page"; }
<section class="site-hero page-hero">
    <div class="shell site-hero-shell hero-grid">
        <div class="hero-copy">
            <span class="eyebrow">AUTOMOTIVE PLATFORM</span>
            <h1>Build the dealer future.</h1>
            <p>APIs, inventory, dealer websites, and tools&mdash;one connected platform.</p>
            <div class="hero-proof">
                <span>14-day trial</span>
                <span>No card required</span>
                <span>Instant credentials</span>
            </div>
        </div>
        <div class="landing-showcase" aria-label="Dealer platform gallery" aria-roledescription="carousel">
            <div class="landing-showcase-slides">
                <div class="landing-showcase-slide active" data-showcase-slide aria-hidden="false">
                    <img src="@Url.Content("~/Content/images/landing-showcase/dealer-inventory-grid.png")" width="1854" height="909" fetchpriority="high" decoding="async" alt="Dealer website inventory search and vehicle cards" />
                    <span>Customer inventory experience</span>
                </div>
                <div class="landing-showcase-slide" data-showcase-slide aria-hidden="true">
                    <img src="@Url.Content("~/Content/images/landing-showcase/vehicle-details-gallery.png")" width="1853" height="916" loading="lazy" decoding="async" alt="Dealer website vehicle photo and lead actions" />
                    <span>Vehicle detail conversion</span>
                </div>
                <div class="landing-showcase-slide" data-showcase-slide aria-hidden="true">
                    <img src="@Url.Content("~/Content/images/landing-showcase/vehicle-pricing-details.png")" width="1848" height="907" loading="lazy" decoding="async" alt="Vehicle pricing and specification details" />
                    <span>Transparent pricing and details</span>
                </div>
                <div class="landing-showcase-slide" data-showcase-slide aria-hidden="true">
                    <img src="@Url.Content("~/Content/images/landing-showcase/inventory-dashboard.png")" width="1850" height="904" loading="lazy" decoding="async" alt="Dealer inventory analytics dashboard" />
                    <span>Inventory intelligence</span>
                </div>
                <div class="landing-showcase-slide" data-showcase-slide aria-hidden="true">
                    <img src="@Url.Content("~/Content/images/landing-showcase/inventory-import-history.png")" width="1853" height="913" loading="lazy" decoding="async" alt="Dealer inventory import history and vehicle statuses" />
                    <span>Automated inventory operations</span>
                </div>
                <div class="landing-showcase-slide" data-showcase-slide aria-hidden="true">
                    <img src="@Url.Content("~/Content/images/landing-showcase/inventory-admin-grid.png")" width="1846" height="903" loading="lazy" decoding="async" alt="Dealer inventory administration grid" />
                    <span>Complete dealer control</span>
                </div>
                <div class="landing-showcase-slide" data-showcase-slide aria-hidden="true">
                    <img src="@Url.Content("~/Content/images/landing-showcase/vin-decoder-report.png")" width="1854" height="903" loading="lazy" decoding="async" alt="VIN decoder with vehicle pricing and specification report" />
                    <span>VIN-powered vehicle data</span>
                </div>
            </div>
            <div class="landing-showcase-dots" aria-label="Choose picture">
                @for (var slide = 0; slide < 7; slide++) { <button class="@(slide == 0 ? "active" : "")" type="button" data-showcase-dot="@slide" aria-label="Show picture @(slide + 1)" aria-pressed="@(slide == 0 ? "true" : "false")">
                </button> }
            </div>
        </div>
    </div>
</section>

<section class="section light-section home-platform-section">
    <div class="shell">
    <div class="section-heading">
        <span class="eyebrow">ONE DEALER PLATFORM</span>
        <h2>Everything after the hero, ready to work together.</h2>
        <p>
            Start with vehicle data or launch the complete dealership experience. Every capability shares the
            same secure account, inventory foundation, and customer workflow.
        </p>
    </div>
    <div class="feature-grid two">
        <article class="feature-card vehicle-intelligence-card">
            <header class="vehicle-intelligence-header">
                <span class="color-icon icon-blue landing-feature-icon" aria-hidden="true">
                    <svg>
                        <use href="#icon-vehicle-data">
                        </use>
                    </svg>
                </span>
                <div>
                    <span class="vehicle-intelligence-eyebrow">VEHICLE INTELLIGENCE</span>
                    <h3>Read the story in 17 characters.</h3>
                    <p>A precise vehicle-data layer, composed for applications and customers alike.</p>
                </div>
            </header>
            <p class="vehicle-intelligence-lead">Seventeen characters go in. A complete vehicle story comes back&mdash;decoded, organized, and ready for the systems and shoppers who need it.</p>
            <div class="vehicle-intelligence-primary-action">
                <a class="vehicle-intelligence-button" href="@Url.Action("VinDecoder", "Solutions")">
                    <span>Explore the AutoDealer.dev VIN Decode API</span>
                    <i aria-hidden="true">&rarr;</i>
                </a>
            </div>
            <div class="vehicle-intelligence-story">
                <article>
                    <span class="vehicle-story-number">01</span>
                    <div>
                        <span class="vehicle-story-kicker">DECODE THE IDENTITY</span>
                        <h4>Turn a VIN into the right vehicle</h4>
                        <p>Start with the fundamentals: year, make, model, trim, body style, drivetrain, and every matching U.S.-market style. One lookup resolves the identity behind the inventory record.</p>
                        <div class="vehicle-data-line" aria-label="Vehicle identity data highlights">
                            <span>Year / Make / Model</span>
                            <span>Trim &amp; Style</span>
                            <span>Body &amp; Drive</span>
                        </div>
                    </div>
                </article>
                <article>
                    <span class="vehicle-story-number">02</span>
                    <div>
                        <span class="vehicle-story-kicker">RETRIEVE THE DETAILS</span>
                        <h4>Bring the mechanical story into focus</h4>
                        <p>Retrieve the facts that shape value and buying decisions&mdash;pricing, engines, transmissions, EPA fuel economy, tires, dimensions, and categorized specifications.</p>
                        <div class="vehicle-data-line" aria-label="Vehicle performance data highlights">
                            <span>Pricing</span>
                            <span>Engine &amp; Transmission</span>
                            <span>EPA Economy</span>
                            <span>Specifications</span>
                        </div>
                    </div>
                </article>
                <article>
                    <span class="vehicle-story-number">03</span>
                    <div>
                        <span class="vehicle-story-kicker">KEEP THE COMPLETE RECORD</span>
                        <h4>Preserve every useful signal</h4>
                        <p>Standard and optional equipment, colors, warranties, attributes, and newly introduced DataOne fields stay intact. Deliver the record as structured JSON, adaptable XML, or responsive HTML.</p>
                        <div class="vehicle-data-line" aria-label="Complete vehicle record highlights">
                            <span>Equipment</span>
                            <span>Colors &amp; Warranties</span>
                            <span>JSON</span>
                            <span>XML</span>
                            <span>HTML</span>
                        </div>
                    </div>
                </article>
            </div>
            <footer class="vehicle-intelligence-footer">
                <div>
                    <span class="vehicle-intelligence-footer-kicker">COMPLETE DATA. CLEAR DELIVERY.</span>
                    <p><strong>Decode with precision. Present with confidence.</strong></p>
                </div>
            </footer>
        </article>
        <article class="feature-card digital-showroom-card">
            <header class="digital-showroom-header">
                <span class="color-icon icon-teal landing-feature-icon" aria-hidden="true">
                    <svg>
                        <use href="#icon-browser">
                        </use>
                    </svg>
                </span>
                <div>
                    <span class="digital-showroom-eyebrow">DIGITAL SHOWROOM</span>
                    <h3>Open the doors before they arrive.</h3>
                    <p>A complete dealership experience, from first impression to inventory command.</p>
                </div>
            </header>
            <p class="digital-showroom-lead">A dealership begins its welcome long before anyone crosses the threshold. The Digital Showroom turns that first quiet moment of interest into a composed, responsive journey shaped by your inventory and your identity.</p>
            <div class="digital-showroom-primary-action">
                <a class="digital-showroom-button" href="@Url.Action("DigitalShowroom", "Solutions")">
                    <span>Explore the complete Digital Showroom</span>
                    <i aria-hidden="true">&rarr;</i>
                </a>
            </div>
            <div class="digital-showroom-story">
                <section>
                    <span class="digital-story-number">01</span>
                    <div>
                        <span class="digital-story-kicker">WELCOME &amp; TRUST</span>
                        <h4>A familiar voice on every page</h4>
                        <p>The Home page opens the door; About reveals the principles behind the dealership; Staff introduces the people customers will meet; Testimonials let genuine experience speak; and Contact turns curiosity into conversation.</p>
                        <div class="digital-page-line" aria-label="Welcome and trust pages">
                            <span>Home</span>
                            <span>About</span>
                            <span>Staff</span>
                            <span>Testimonials</span>
                            <span>Contact</span>
                        </div>
                    </div>
                </section>
                <section>
                    <span class="digital-story-number">02</span>
                    <div>
                        <span class="digital-story-kicker">DISCOVERY &amp; CONVERSION</span>
                        <h4>Give every vehicle its moment</h4>
                        <p>Fast inventory search and precise filters lead into detailed vehicle pages with generous galleries, transparent pricing, specifications, financing, contact, and test-drive opportunities. The finance application carries intent forward, while stories and announcements keep the showroom alive between visits.</p>
                        <p>Privacy and Terms pages complete the experience with the clarity a professional relationship deserves.</p>
                        <div class="digital-page-line" aria-label="Discovery and conversion pages">
                            <span>Inventory</span>
                            <span>Vehicle details</span>
                            <span>Finance application</span>
                            <span>Test drive</span>
                            <span>Stories</span>
                            <span>Announcements</span>
                            <span>Privacy</span>
                            <span>Terms</span>
                        </div>
                    </div>
                </section>
                <section>
                    <span class="digital-story-number">03</span>
                    <div>
                        <span class="digital-story-kicker">ADMIN OPERATIONS</span>
                        <h4>Quiet command behind the glass</h4>
                        <p>Enter or edit inventory manually and let the integrated VIN decoder complete essential vehicle details, or import inventory from Frazer and other compatible sources. Preview each synchronization and follow vehicles as they are added, updated, sold, or stalled.</p>
                        <p>Manage photographs and image order, vehicle stories, DataOne intelligence, printable QR materials, publishing status, customer views, and inventory history from one deliberate workspace.</p>
                        <div class="digital-page-line" aria-label="Admin operations capabilities">
                            <span>Manual entry</span>
                            <span>VIN-assisted details</span>
                            <span>Frazer imports</span>
                            <span>Reconciliation</span>
                            <span>Media</span>
                            <span>QR</span>
                            <span>Analytics</span>
                        </div>
                    </div>
                </section>
            </div>
            <footer class="digital-showroom-footer">
                <div>
                    <span class="digital-showroom-footer-kicker">ONE PLATFORM. ONE CONTINUOUS STORY.</span>
                    <p class="digital-showroom-signoff"><strong>From the first online glance to the moment keys meet an open hand, every detail arrives prepared.</strong></p>
                </div>
            </footer>
        </article>
    </div>
</div>
</section>

@section scripts {
<script>
$(function () {
    var $showcase = $('.landing-showcase'), $slides = $showcase.find('[data-showcase-slide]'), $dots = $showcase.find('[data-showcase-dot]');
    var current = 0, timer;
    function showSlide(index) {
        current = (index + $slides.length) % $slides.length;
        $slides.removeClass('active').attr('aria-hidden', 'true').eq(current).addClass('active').attr('aria-hidden', 'false');
        $dots.removeClass('active').attr('aria-pressed', 'false').eq(current).addClass('active').attr('aria-pressed', 'true');
    }
    function start() { window.clearInterval(timer); if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(function () { showSlide(current + 1); }, 4500); }
    function restart() { window.clearInterval(timer); start(); }
    $dots.on('click', function () { showSlide(Number($(this).data('showcase-dot'))); restart(); });
    $showcase.on('mouseenter focusin', function () { window.clearInterval(timer); }).on('mouseleave focusout', start);
    start();
});
</script>
}
