@{ ViewBag.Title = "Pricing"; }
<section class="page-hero pricing-hero"><div class="shell narrow"><span class="eyebrow">SIMPLE PRICING</span><h1>Start focused.<br /><em>Scale without friction.</em></h1><p>Every plan includes secure API keys, complete response formats, usage metering, and access to the dealer API documentation.</p></div></section>
<section class="section pricing-section"><div class="shell pricing-grid">
    <article class="price-card"><span class="plan-name">STARTER</span><h2>$50<small>/month</small></h2><p>Independent developers and small dealer rooftops.</p><strong>50 requests monthly</strong><ul class="check-list"><li>VIN Decode API</li><li>JSON, XML, and HTML</li><li>Secure API credentials</li><li>Email support</li></ul><a class="button button-outline" href="@Url.Action("Register", "Account", new { plan = "STARTER" })">Start 14-day trial</a></article>
    <article class="price-card featured-price"><span class="popular-label">RECOMMENDED</span><span class="plan-name">GROWTH</span><h2>$150<small>/month</small></h2><p>Production applications and growing dealer teams.</p><strong>150 requests monthly</strong><ul class="check-list"><li>Everything in Starter</li><li>Five API keys</li><li>Per-key usage visibility</li><li>Priority support</li></ul><a class="button button-primary" href="@Url.Action("Register", "Account", new { plan = "GROWTH" })">Choose Growth</a></article>
    <article class="price-card"><span class="plan-name">PLATFORM</span><h2>$250<small>/month</small></h2><p>The complete dealer website and operating platform.</p><strong>250 requests monthly</strong><ul class="check-list"><li>Everything in Growth</li><li>Dealer website and inventory</li><li>Dedicated onboarding</li></ul><a class="button button-outline" href="@Url.Action("Register", "Account", new { plan = "PLATFORM" })">Choose Platform</a></article>
</div></section>
<section class="section faq-section"><div class="shell two-col"><div><span class="eyebrow dark">COMMON QUESTIONS</span><h2>Clear terms before you build.</h2></div><div class="accordion">
    <article><button type="button">Do I need a card for the trial?<span>+</span></button><p>No. Create the account and test the API for 14 days before adding a payment method.</p></article>
    <article><button type="button">How are API calls counted?<span>+</span></button><p>Every authenticated request is metered atomically against the active subscription and summarized daily per client.</p></article>
    <article><button type="button">Can I rotate an API key?<span>+</span></button><p>Yes. Keys are designed to be revoked and reissued independently of the customer account.</p></article>
    <article><button type="button">Do you store credit card numbers?<span>+</span></button><p>No. A hosted payment provider returns an opaque token. The application never receives or stores a card number or CVV.</p></article>
</div></div></section>
@section scripts {<script>$(function () { $('.accordion button').on('click', function () { var $article = $(this).closest('article'); $article.toggleClass('open').siblings().removeClass('open'); }); });</script>}
