@model autodealer.dev.Models.PricingPageViewModel
@{ ViewBag.Title = "Pricing"; }
<section class="page-hero pricing-hero"><div class="shell narrow"><span class="eyebrow">SIMPLE PRICING</span><h1>Start focused. Scale without friction.</h1><p>Every plan includes secure API keys, complete response formats, usage metering, and access to the dealer API documentation.</p></div></section>
<section class="section light-section pricing-section"><div class="shell pricing-grid">
    @if (Model.Plans.Count == 0) {
        <div class="pricing-empty">No plans are currently available.</div>
    }
    @foreach (var plan in Model.Plans) {
        <article class="price-card @(plan.IsRecommended ? "featured-price" : "")">
            @if (plan.IsRecommended) { <span class="popular-label">RECOMMENDED</span> }
            <span class="plan-name">@plan.DisplayName.ToUpperInvariant()</span>
            @if (plan.MonthlyPrice.HasValue) {
                <h2>@plan.MonthlyPrice.Value.ToString("$0.##")<small>/month</small></h2>
            } else {
                <h2>Custom</h2>
            }
            <p>@plan.DisplayName access for automotive applications and dealership teams.</p>
            <strong>@plan.MonthlyRequestQuota.ToString("N0") requests monthly</strong>
            <ul class="check-list">
                <li>@(plan.MaxApiKeys == 1 ? "1 secure API key" : plan.MaxApiKeys.ToString("N0") + " secure API keys")</li>
                <li>VIN Decode API</li>
                <li>JSON, XML, and HTML</li>
                <li>Usage visibility</li>
            </ul>
            <a class="button @(plan.IsRecommended ? "button-primary" : "button-outline")" href="@Url.Action("Register", "Account", new { plan = plan.PlanCode })">Choose @plan.DisplayName</a>
        </article>
    }
</div></section>
<section class="section light-section faq-section"><div class="shell two-col"><div><span class="eyebrow dark">COMMON QUESTIONS</span><h2>Clear terms before you build.</h2></div><div class="accordion">
    <article><button type="button">Do I need a card for the trial?<span>+</span></button><p>No. Create the account and test the API for 14 days before adding a payment method.</p></article>
    <article><button type="button">How are API calls counted?<span>+</span></button><p>Every authenticated request is metered atomically against the active subscription and summarized daily per client.</p></article>
    <article><button type="button">Can I rotate an API key?<span>+</span></button><p>Yes. Keys are designed to be revoked and reissued independently of the customer account.</p></article>
    <article><button type="button">Do you store credit card numbers?<span>+</span></button><p>No. A hosted payment provider returns an opaque token. The application never receives or stores a card number or CVV.</p></article>
</div></div></section>
@section scripts {<script>$(function () { $('.accordion button').on('click', function () { var $article = $(this).closest('article'); $article.toggleClass('open').siblings().removeClass('open'); }); });</script>}
