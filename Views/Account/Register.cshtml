@model autodealer.dev.Models.AccountRegistrationViewModel
@{ ViewBag.Title = "Create your account"; ViewBag.BodyClass = "account-page"; }
<section class="account-shell"><div class="shell account-grid">
    <div class="account-intro"><a class="back-link" href="@Url.Action("Index", "Home")">&larr; Back to AutoDealer.dev</a><span class="eyebrow">CREATE YOUR WORKSPACE</span><h1>Get your API key<br /><em>and start building.</em></h1><p>Your 14-day trial includes real API credentials and usage tracking. No payment method is required today.</p><ul><li><b>01</b><span><strong>Secure credentials</strong>Generated once and stored as a digest.</span></li><li><b>02</b><span><strong>Per-client usage</strong>Every authenticated request is metered.</span></li><li><b>03</b><span><strong>Safe billing design</strong>Payment data goes directly to your provider.</span></li></ul></div>
    <div class="form-card">
        <span class="form-step">ACCOUNT DETAILS</span><h2>Create your workspace</h2><p>Already registered? <a href="@Url.Action("Login", "Account")">Sign in</a></p>
        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "account-form", autocomplete = "on" })) {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
            <div class="form-field">@Html.LabelFor(m => m.BusinessName)@Html.TextBoxFor(m => m.BusinessName, new { placeholder = "Northstar Motors", autocomplete = "organization" })@Html.ValidationMessageFor(m => m.BusinessName)</div>
            <div class="form-row"><div class="form-field">@Html.LabelFor(m => m.FirstName)@Html.TextBoxFor(m => m.FirstName, new { placeholder = "Alex", autocomplete = "given-name" })@Html.ValidationMessageFor(m => m.FirstName)</div><div class="form-field">@Html.LabelFor(m => m.LastName)@Html.TextBoxFor(m => m.LastName, new { placeholder = "Morgan", autocomplete = "family-name" })@Html.ValidationMessageFor(m => m.LastName)</div></div>
            <div class="form-row"><div class="form-field">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "alex@dealership.com", autocomplete = "email" })@Html.ValidationMessageFor(m => m.Email)</div><div class="form-field">@Html.LabelFor(m => m.Phone)@Html.TextBoxFor(m => m.Phone, new { type = "tel", placeholder = "(555) 012-3456", autocomplete = "tel" })@Html.ValidationMessageFor(m => m.Phone)</div></div>
            <div class="form-row"><div class="form-field">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { placeholder = "12 or more characters", autocomplete = "new-password" })@Html.ValidationMessageFor(m => m.Password)</div><div class="form-field">@Html.LabelFor(m => m.PlanCode)@Html.DropDownListFor(m => m.PlanCode, new[] { new SelectListItem { Text = "Starter - $50/mo", Value = "STARTER" }, new SelectListItem { Text = "Growth - $150/mo", Value = "GROWTH" }, new SelectListItem { Text = "Platform - $250/mo", Value = "PLATFORM" } })@Html.ValidationMessageFor(m => m.PlanCode)</div></div>
            <label class="check-field">@Html.CheckBoxFor(m => m.AcceptTerms)<span>I agree to the service terms and privacy policy.</span></label>@Html.ValidationMessageFor(m => m.AcceptTerms)
            <button class="button button-primary submit-button" type="submit">Create account and issue key <span>&rarr;</span></button><small class="form-secure">Protected by TLS &middot; API secrets are displayed once</small>
        }
    </div>
</div></section>
