@model autodealer.dev.Models.AccountLoginViewModel
@{ ViewBag.Title = "Sign in"; ViewBag.BodyClass = "account-page login-page"; }
<section class="account-shell"><div class="shell account-grid login-grid">
    <div class="account-intro"><a class="back-link" href="@Url.Action("Index", "Home")">&larr; Back to AutoDealer.dev</a><span class="eyebrow">CLIENT ACCESS</span><h1>Welcome back.<br /><em>Keep building.</em></h1><p>Sign in with the email and password used when your AutoDealer.dev account was created.</p><ul><li><b>01</b><span><strong>Account overview</strong>Review your active plan and billing period.</span></li><li><b>02</b><span><strong>API key status</strong>See how many active credentials are available.</span></li><li><b>03</b><span><strong>Protected access</strong>Repeated failed attempts trigger a temporary lock.</span></li></ul></div>
    <div class="form-card login-card">
        <span class="form-step">SECURE SIGN IN</span><h2>Access your workspace</h2><p>New to AutoDealer.dev? <a href="@Url.Action("Register", "Account")">Create an account</a></p>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "account-form", autocomplete = "on" })) {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
            <div class="form-field">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { type = "email", placeholder = "you@dealership.com", autocomplete = "email", autofocus = "autofocus" })@Html.ValidationMessageFor(m => m.Email)</div>
            <div class="form-field">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { placeholder = "Your account password", autocomplete = "current-password" })@Html.ValidationMessageFor(m => m.Password)</div>
            <label class="check-field remember-field">@Html.CheckBoxFor(m => m.RememberMe)<span>Keep me signed in on this device</span></label>
            <button class="button button-primary submit-button" type="submit">Sign in to your account <span>&rarr;</span></button>
            <small class="form-secure">Encrypted session &middot; Passwords are never stored in plain text</small>
        }
    </div>
</div></section>
