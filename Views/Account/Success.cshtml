@model autodealer.dev.Models.AccountCreatedViewModel
@{
    ViewBag.Title = "Check your email";
    ViewBag.BodyClass = "account-page";
    ViewBag.ShowWorkspaceConfirmationLinks = true;
}
<section class="site-hero page-hero"><div class="shell site-hero-shell"><div class="hero-copy"><span class="eyebrow">ONE STEP REMAINS</span><h1>Check your inbox.</h1><p>Confirm your email to activate the workspace and securely receive your credentials.</p></div></div></section>
<div class="modal fade workspace-confirmation-modal" id="workspace-confirmation-modal" tabindex="-1" aria-labelledby="workspace-confirmation-heading" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">@Html.Partial("_WorkspaceConfirmation", Model)</div>
    </div>
</div>
@section scripts {
    <script>
        $(function () {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('workspace-confirmation-modal'), { backdrop: 'static' }).show();
        });
    </script>
}
