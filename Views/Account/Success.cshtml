@model autodealer.dev.Models.AccountCreatedViewModel
@{ ViewBag.Title = "Check your email"; ViewBag.BodyClass = "account-page"; }
<section class="site-hero page-hero"><div class="shell site-hero-shell"><div class="hero-copy"><span class="eyebrow">ONE STEP REMAINS</span><h1>Check your inbox.</h1><p>Confirm your email to activate the workspace and securely receive your credentials.</p></div></div></section>
<section class="section light-section account-content-section success-page"><div class="shell"><div class="success-card verification-pending-card">
    @Html.Partial("_WorkspaceConfirmation", Model)
    <div class="button-row centered-row"><a class="button button-primary" href="@Url.Action("Index", "Documentation")">Preview the documentation &rarr;</a><a class="button button-outline" href="@Url.Action("Index", "Home")">Return home</a></div>
</div></div></section>
