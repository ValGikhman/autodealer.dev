@model autodealer.dev.Models.AccountDashboardViewModel
@{ ViewBag.Title = "My account"; ViewBag.BodyClass = "dashboard-page"; }
<section class="site-hero page-hero dashboard-hero">
    <div class="shell site-hero-shell">
        <div class="hero-copy">
            <span class="eyebrow">CLIENT WORKSPACE</span>
            <h1>Welcome, @Model.ContactName.</h1>
            <p>@Model.BusinessName &middot; @Model.ClientNumber</p>
        </div>
    </div>
</section>
<section class="section light-section dashboard-section">
    <div class="shell">
    <div class="section-heading">
        <span class="eyebrow">ACCOUNT OVERVIEW</span>
        <h2>Your platform at a glance.</h2>
        <span class="status-badge@(Model.PaymentRequired ? " payment-required-status" : "")">@Model.SubscriptionStatus</span>
    </div>
    <div class="dashboard-grid">
        <article>
            <span class="color-icon metric-icon" aria-hidden="true">
                <svg>
                    <use href="#icon-plan">
                    </use>
                </svg>
            </span>
            <span>PLAN</span>
            <strong>@Model.PlanName</strong>
            <small>Current subscription</small>
        </article>
        <article>
            <span class="color-icon metric-icon" aria-hidden="true">
                <svg>
                    <use href="#icon-gauge">
                    </use>
                </svg>
            </span>
            <span>MONTHLY QUOTA</span>
            <strong>@Model.MonthlyRequestQuota</strong>
            <small>API requests per period</small>
        </article>
        <article>
            <span class="color-icon metric-icon" aria-hidden="true">
                <svg>
                    <use href="#icon-key">
                    </use>
                </svg>
            </span>
            <span>ACTIVE KEYS</span>
            <strong>@Model.ActiveApiKeyCount</strong>
            <small>Credentials ready to use</small>
        </article>
        <article class="@(Model.PaymentRequired ? "payment-required-card" : string.Empty)">
            <span class="color-icon metric-icon" aria-hidden="true">
                <svg>
                    <use href="#icon-calendar">
                    </use>
                </svg>
            </span>
            <span>@(Model.PaymentRequired ? "PAYMENT REQUIRED" : "PERIOD ENDS")</span>
            <strong>@(Model.CurrentPeriodEndUtc.HasValue ? Model.CurrentPeriodEndUtc.Value.ToString("MMM d") : "N/A")</strong>
            <small>@(Model.PaymentRequired ? "Your subscription access is paused" : Model.CurrentPeriodEndUtc.HasValue ? Model.CurrentPeriodEndUtc.Value.ToString("yyyy 'at' HH:mm 'UTC'") : "No active billing period")</small>@if (Model.PaymentRequired) { if (!string.IsNullOrWhiteSpace(Model.PaymentUrl)) { <button class="payment-information-button" type="button" data-payment-url="@Model.PaymentUrl" onclick="window.location.assign(this.getAttribute('data-payment-url'))">Add payment info</button> } else { <button class="payment-information-button" type="button" disabled title="Payment link coming soon">Add payment info</button> } }</article>
    </div>
    <section class="account-research" aria-labelledby="account-research-heading">
        <div class="section-heading"><span class="eyebrow">VEHICLE INTELLIGENCE</span><h2 id="account-research-heading">Research tools</h2></div>
        <div class="dashboard-grid account-research-grid">
            <article><span>VEHICLE PRICING</span><strong>Price Research</strong><small>Compare listings, check local demand, and calculate an auction bid.</small><a class="button button-primary" href="@Url.RouteUrl("ClientPriceResearch")">Open Price Research &rarr;</a></article>
            <article><span>VEHICLE SPECIFICATIONS</span><strong>VIN Decoder</strong><small>Look up a vehicle's trim, equipment, and specifications by VIN.</small><a class="button button-primary" href="@Url.RouteUrl("ClientVinDecoder")">Open VIN Decoder &rarr;</a></article>
        </div>
    </section>
    <div class="dashboard-footer">
        <div>
            <span>ACCOUNT EMAIL</span>
            <strong>@Model.Email</strong>
        </div>
        <a class="button button-primary" href="@Url.Action("Index", "Documentation")">Open API documentation &rarr;</a>
    </div>
</div>
</section>
