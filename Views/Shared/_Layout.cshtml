@{
    var pageTitle = (ViewBag.Title ?? "Dealer APIs and digital solutions").ToString();
    var pageDescription = (ViewBag.Description ?? "Dealer-ready APIs for VIN decoding, inventory, websites, and automotive retail workflows.").ToString();
    var canonicalUrl = ViewBag.CanonicalUrl as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111923" />
    <meta name="description" content="@pageDescription" />
    <meta name="robots" content="@(ViewBag.Robots ?? "index,follow")" />
    <title>@pageTitle | AutoDealer.dev</title>
    @if (!string.IsNullOrWhiteSpace(canonicalUrl)) {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AutoDealer.dev" />
    <meta property="og:title" content="@pageTitle | AutoDealer.dev" />
    <meta property="og:description" content="@pageDescription" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle | AutoDealer.dev" />
    <meta name="twitter:description" content="@pageDescription" />
    <link rel="icon" href="@Url.Content("~/favicon.ico")" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("head", required: false)
</head>
<body class="@ViewBag.BodyClass">
    <svg class="icon-sprite" aria-hidden="true" focusable="false">
        <symbol id="icon-vehicle-data" viewBox="0 0 24 24"><path d="M4 14l1.7-5.1A2 2 0 0 1 7.6 7h8.8a2 2 0 0 1 1.9 1.9L20 14M3 14h18v4a1 1 0 0 1-1 1h-1v2h-2v-2H7v2H5v-2H4a1 1 0 0 1-1-1v-4Z"/><path d="M6.5 15.5h2m7 0h2M6 11h12"/></symbol>
        <symbol id="icon-browser" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8h18M7 6h.01M10 6h.01M7 12h4v4H7zm7 0h3m-3 3h3"/></symbol>
        <symbol id="icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></symbol>
        <symbol id="icon-support" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="m5.6 5.6 3.6 3.6m5.6 5.6 3.6 3.6m0-12.8-3.6 3.6m-5.6 5.6-3.6 3.6"/></symbol>
        <symbol id="icon-plan" viewBox="0 0 24 24"><path d="m12 3 8 4-8 4-8-4 8-4Z"/><path d="m4 12 8 4 8-4M4 17l8 4 8-4"/></symbol>
        <symbol id="icon-gauge" viewBox="0 0 24 24"><path d="M4.2 18a9 9 0 1 1 15.6 0"/><path d="m12 12 4-3M7 18h10"/></symbol>
        <symbol id="icon-key" viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"/><path d="M12 12h9m-3 0v3m-3-3v2"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-14 4h3m3 0h4m-10 3h3"/></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2m1-15a3 3 0 0 1 0 6m1 2a5 5 0 0 1 4 5v2"/></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></symbol>
        <symbol id="icon-trial" viewBox="0 0 24 24"><path d="M9 3h6m-5 0v5l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/></symbol>
        <symbol id="icon-code" viewBox="0 0 24 24"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-2-12-4 14"/></symbol>
    </svg>
    <header class="site-header">
        <div class="shell nav-shell">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="AutoDealer.dev home"><span class="brand-mark">AD</span><span>autodealer<span>.dev</span></span></a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span></span><span></span></button>
            <nav class="site-nav" id="site-nav">
                @if (User.IsInRole("Admin")) {
                    <a href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
                    <a href="@Url.Action("Customers", "Admin")">Customers</a>
                    using (Html.BeginForm("Logout", "Admin", FormMethod.Post, new { @class = "nav-logout" })) { @Html.AntiForgeryToken()<button type="submit">Sign out</button> }
                } else {
                    <a href="@Url.Action("Index", "Solutions")">Solutions</a>
                    <a href="@Url.Action("Index", "Documentation")">Documentation</a>
                    <a href="@Url.Action("Index", "Pricing")">Pricing</a>
                    if (Request.IsAuthenticated) {
                        <a class="nav-quiet" href="@Url.Action("Dashboard", "Account")">My account</a>
                        using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "nav-logout" })) { @Html.AntiForgeryToken()<button type="submit">Sign out</button> }
                    } else {
                        <a class="nav-quiet" href="@Url.Action("Login", "Account")">Sign in</a>
                        <a class="button site-cta" href="@Url.Action("Register", "Account")">
                            <span>Get an API key</span>
                            <i aria-hidden="true">&rarr;</i>
                        </a>
                    }
                }
            </nav>
        </div>
    </header>

    <main>@RenderBody()</main>

    <footer class="site-footer">
        <div class="shell footer-grid">
            <div><a class="brand" href="@Url.Action("Index", "Home")"><span class="brand-mark">AD</span><span>autodealer<span>.dev</span></span></a></div>
            <div><strong>PRODUCT</strong><a href="@Url.Action("VinDecoder", "Solutions")">VIN Decode</a><a href="@Url.Action("DigitalShowroom", "Solutions")">Dealer Website</a></div>
            <div><strong>DEVELOPERS</strong><a href="@Url.Action("Index", "Documentation")">Quickstart</a><a href="@Url.Action("Authentication", "Documentation")">Authentication</a><a href="@Url.Action("Errors", "Documentation")">Errors &amp; limits</a></div>
            <div><strong>COMPANY</strong><a href="@Url.Action("About", "Home")">About</a><a href="@Url.Action("Contact", "Home")">Contact</a><a href="@Url.Action("Index", "Pricing")">Pricing</a></div>
        </div>
        <div class="shell footer-bottom"><span>&copy; @DateTime.UtcNow.Year AutoDealer.dev. All rights reserved.</span><span>Built for dealers who build what&rsquo;s next.</span></div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        if ($.validator && $.validator.unobtrusive) {
            $.validator.addMethod('mustbetrue', function (value, element) { return element.checked; });
            $.validator.unobtrusive.adapters.addBool('mustbetrue');
        }
        $(function () {
            $('.nav-toggle').on('click', function () { var open = $(this).attr('aria-expanded') === 'true'; $(this).attr('aria-expanded', !open); $('#site-nav').toggleClass('open', !open); });
            $('.site-nav a').on('click', function () { $('#site-nav').removeClass('open'); $('.nav-toggle').attr('aria-expanded', 'false'); });
            $('[data-copy]').on('click', function () { var $button = $(this), text = $($button.data('copy')).text(); navigator.clipboard.writeText(text).then(function () { var old = $button.text(); $button.text('Copied'); setTimeout(function () { $button.text(old); }, 1400); }); });
            $('[data-tab]').on('click', function () { var name = $(this).data('tab'); $('[data-tab]').removeClass('active'); $(this).addClass('active'); $('[data-code]').attr('hidden', true); $('[data-code="' + name + '"]').removeAttr('hidden'); });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
