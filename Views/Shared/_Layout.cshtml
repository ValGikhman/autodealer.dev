@using System
@using System.Collections.Generic
@using System.Configuration
@using System.Text.RegularExpressions
@using autodealer.dev.Services
@{
    var pageTitle = (ViewBag.Title ?? "Dealer APIs and digital solutions").ToString();
    var pageDescription = (ViewBag.Description ?? "Dealer-ready APIs for VIN decoding, inventory, websites, and automotive retail workflows.").ToString();
    var canonicalUrl = ViewBag.CanonicalUrl as string ?? SeoUrl.Absolute(Request.Url == null ? "/" : Request.Url.AbsolutePath);
    var socialImageUrl = ViewBag.SocialImageUrl as string ?? SeoUrl.Absolute("/Content/images/vtec-dealer-showroom-ad-v2.png");
    var indexingEnabled = string.Equals(ConfigurationManager.AppSettings["Seo:AllowIndexing"], "true", StringComparison.OrdinalIgnoreCase);
    var robots = indexingEnabled ? (ViewBag.Robots ?? "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1").ToString() : "noindex,nofollow";
    var googleAnalyticsId = (ConfigurationManager.AppSettings["GoogleAnalytics:MeasurementId"] ?? string.Empty).Trim().ToUpperInvariant();
    if (!Regex.IsMatch(googleAnalyticsId, @"^G-[A-Z0-9]+$")) { googleAnalyticsId = string.Empty; }
    var googleSiteVerification = (ConfigurationManager.AppSettings["GoogleSearchConsole:VerificationToken"] ?? string.Empty).Trim();
    var controllerName = (ViewContext.RouteData.Values["controller"] ?? string.Empty).ToString();
    var actionName = (ViewContext.RouteData.Values["action"] ?? string.Empty).ToString();
    string organizationJson = null;
    if (controllerName.Equals("Home", StringComparison.OrdinalIgnoreCase) && actionName.Equals("Index", StringComparison.OrdinalIgnoreCase)) {
        var organizationData = new Dictionary<string, object> {
            { "@context", "https://schema.org" },
            { "@graph", new object[] {
                new Dictionary<string, object> {
                    { "@type", "Organization" }, { "@id", SeoUrl.Absolute("/#organization") },
                    { "name", "AutoDealer.dev" }, { "url", SeoUrl.Absolute("/") },
                    { "logo", SeoUrl.Absolute("/Content/images/autodealer-logo.png") },
                    { "email", "sales@autodealer.dev" },
                    { "description", pageDescription }
                },
                new Dictionary<string, object> {
                    { "@type", "WebSite" }, { "@id", SeoUrl.Absolute("/#website") },
                    { "name", "AutoDealer.dev" }, { "url", SeoUrl.Absolute("/") },
                    { "publisher", new Dictionary<string, object> { { "@id", SeoUrl.Absolute("/#organization") } } }
                }
            } }
        };
        organizationJson = Newtonsoft.Json.JsonConvert.SerializeObject(organizationData, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml });
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    @if (!string.IsNullOrWhiteSpace(googleAnalyticsId)) {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@googleAnalyticsId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@googleAnalyticsId');
        </script>
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111923" />
    <meta name="description" content="@pageDescription" />
    <meta name="robots" content="@robots" />
    @if (!string.IsNullOrWhiteSpace(googleSiteVerification)) { <meta name="google-site-verification" content="@googleSiteVerification" /> }
    <title>@pageTitle | AutoDealer.dev</title>
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="sitemap" type="application/xml" href="@SeoUrl.Absolute("/sitemap.xml")" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="AutoDealer.dev" />
    <meta property="og:title" content="@pageTitle | AutoDealer.dev" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:alt" content="AutoDealer.dev automotive API and dealer platform" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle | AutoDealer.dev" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@socialImageUrl" />
    <link rel="icon" href="@Url.Content("~/favicon.ico")" />
    @Styles.Render("~/Content/css")
    @if (!string.IsNullOrWhiteSpace(organizationJson)) { <script type="application/ld+json">@Html.Raw(organizationJson)</script> }
    @RenderSection("head", required: false)
</head>
<body class="@ViewBag.BodyClass">
    <svg class="icon-sprite" aria-hidden="true" focusable="false">
        <symbol id="icon-vehicle-data" viewBox="0 0 24 24"><path d="M4 14l1.7-5.1A2 2 0 0 1 7.6 7h8.8a2 2 0 0 1 1.9 1.9L20 14M3 14h18v4a1 1 0 0 1-1 1h-1v2h-2v-2H7v2H5v-2H4a1 1 0 0 1-1-1v-4Z"/><path d="M6.5 15.5h2m7 0h2M6 11h12"/></symbol>
        <symbol id="icon-browser" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8h18M7 6h.01M10 6h.01M7 12h4v4H7zm7 0h3m-3 3h3"/></symbol>
        <symbol id="icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></symbol>
        <symbol id="icon-support" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="m5.6 5.6 3.6 3.6m5.6 5.6 3.6 3.6m0-12.8-3.6 3.6m-5.6 5.6-3.6 3.6"/></symbol>
        <symbol id="icon-plan" viewBox="0 0 24 24"><path d="m12 3 8 4-8 4-8-4 8-4Z"/><path d="m4 12 8 4 8-4M4 17l8 4 8-4"/></symbol>
        <symbol id="icon-gauge" viewBox="0 0 24 24"><path d="M4.2 18a9 9 0 1 1 15.6 0"/><path d="m12 12 4-3M7 18h10"/></symbol>
        <symbol id="icon-key" viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"/><path d="M12 12h9m-3 0v3m-3-3v2"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-14 4h3m3 0h4m-10 3h3"/></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2m1-15a3 3 0 0 1 0 6m1 2a5 5 0 0 1 4 5v2"/></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></symbol>
        <symbol id="icon-trial" viewBox="0 0 24 24"><path d="M9 3h6m-5 0v5l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/></symbol>
        <symbol id="icon-code" viewBox="0 0 24 24"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-2-12-4 14"/></symbol>
    </svg>
    <header class="site-header">
        <div class="shell nav-shell">
            <a class="brand header-brand-logo" href="@Url.Action("Index", "Home")" aria-label="AutoDealer.dev home"><img class="brand-logo" src="@Url.Content("~/Content/images/autodealer-logo-light.png")" width="1299" height="208" alt="AutoDealer.dev" decoding="async" /></a>
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span></span><span></span></button>
            <nav class="site-nav" id="site-nav">
                @if (User.IsInRole("Admin")) {
                    <a href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
                    <a href="@Url.Action("Customers", "Admin")">Customers</a>
                    using (Html.BeginForm("Logout", "Admin", FormMethod.Post, new { @class = "nav-logout" })) { @Html.AntiForgeryToken()<button type="submit">Sign out</button> }
                } else {
                    <a href="@Url.Action("Index", "Solutions")">Solutions</a>
                    <a href="@Url.Action("Index", "Documentation")">Documentation</a>
                    <a href="@Url.Action("Index", "Pricing")">Pricing</a>
                    if (Request.IsAuthenticated) {
                        <a class="nav-quiet" href="@Url.Action("Dashboard", "Account")">My account</a>
                        using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "nav-logout" })) { @Html.AntiForgeryToken()<button type="submit">Sign out</button> }
                    } else {
                        <a class="nav-quiet" href="@Url.Action("Login", "Account")">Sign in</a>
                        <a class="button site-cta" href="@Url.Action("Register", "Account")">
                            <span>Get an API key</span>
                            <i aria-hidden="true">&rarr;</i>
                        </a>
                    }
                }
            </nav>
        </div>
    </header>

    <main>@RenderBody()</main>

    @if (!(ViewBag.HideLegalModal is bool && (bool)ViewBag.HideLegalModal)) {
        <div class="modal fade legal-modal" id="legal-modal" tabindex="-1" aria-labelledby="legal-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header legal-modal-header">
                        <div><span>TERMS &amp; PRIVACY</span><h2 class="modal-title" id="legal-modal-title">The details behind the agreement.</h2><p>Read the Service Terms and Privacy Policy without leaving your form.</p></div>
                        <button type="button" class="btn-close legal-modal-close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
                    </div>
                    <div class="modal-body legal-modal-body">@Html.Partial("_LegalTermsPrivacy")</div>
                    <div class="modal-footer legal-modal-footer"><a href="@Url.Action("Legal", "Home")">Open the full page</a><button type="button" data-bs-dismiss="modal">Done reading</button></div>
                </div>
            </div>
        </div>
    }

    <footer class="site-footer">
        <div class="shell footer-grid">
            <div><a class="brand footer-brand-logo" href="@Url.Action("Index", "Home")" aria-label="AutoDealer.dev home"><img class="brand-logo" src="@Url.Content("~/Content/images/autodealer-logo.png")" width="1134" height="193" alt="AutoDealer.dev" loading="lazy" decoding="async" /></a></div>
            <div><strong>PRODUCT</strong><a href="@Url.Action("VinDecoder", "Solutions")">VIN Decode</a><a href="@Url.Action("DigitalShowroom", "Solutions")">Dealer Website</a></div>
            <div><strong>DEVELOPERS</strong><a href="@Url.Action("Index", "Documentation")">Quickstart</a><a href="@Url.Action("VinHtml", "Documentation")">HTML VIN report</a><a href="@Url.Action("Authentication", "Documentation")">Authentication</a><a href="@Url.Action("Errors", "Documentation")">Errors &amp; limits</a></div>
            <div><strong>COMPANY</strong><a href="@Url.Action("About", "Home")">About</a><a href="@Url.Action("Contact", "Home")">Contact</a><a href="@Url.Action("Index", "Pricing")">Pricing</a><a href="@Url.Action("Legal", "Home")">Terms &amp; Privacy</a></div>
        </div>
        <div class="shell footer-bottom"><span>&copy; @DateTime.UtcNow.Year AutoDealer.dev. All rights reserved.</span><span>Built for dealers who build what&rsquo;s next.</span></div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @if (ViewBag.IncludeValidation is bool && (bool)ViewBag.IncludeValidation) { @Scripts.Render("~/bundles/jqueryval") }
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        if ($.validator && $.validator.unobtrusive) {
            $.validator.addMethod('mustbetrue', function (value, element) { return element.checked; });
            $.validator.unobtrusive.adapters.addBool('mustbetrue');
        }
        $(function () {
            function formatPhone(value) {
                var digits = (value || '').replace(/\D/g, '');
                if (digits.length > 10 && digits.charAt(0) === '1') digits = digits.substring(1);
                digits = digits.substring(0, 10);
                if (!digits.length) return '';
                if (digits.length <= 3) return '(' + digits;
                if (digits.length <= 6) return '(' + digits.substring(0, 3) + ') ' + digits.substring(3);
                return '(' + digits.substring(0, 3) + ') ' + digits.substring(3, 6) + '-' + digits.substring(6);
            }

            var $phoneFields = $('input[type="tel"]');
            $phoneFields.attr({ inputmode: 'tel', maxlength: '14' }).each(function () {
                this.value = formatPhone(this.value);
            }).on('input', function () {
                this.value = formatPhone(this.value);
            });

            $('.nav-toggle').on('click', function () { var open = $(this).attr('aria-expanded') === 'true'; $(this).attr('aria-expanded', !open); $('#site-nav').toggleClass('open', !open); });
            $('.site-nav a').on('click', function () { $('#site-nav').removeClass('open'); $('.nav-toggle').attr('aria-expanded', 'false'); });
            $('[data-copy]').on('click', function () { var $button = $(this), text = $($button.data('copy')).text(); navigator.clipboard.writeText(text).then(function () { var old = $button.text(); $button.text('Copied'); setTimeout(function () { $button.text(old); }, 1400); }); });
            $('[data-tab]').on('click', function () { var name = $(this).data('tab'); $('[data-tab]').removeClass('active'); $(this).addClass('active'); $('[data-code]').attr('hidden', true); $('[data-code="' + name + '"]').removeAttr('hidden'); });
            $(document).on('click', '[data-legal-modal]', function (event) {
                if (!window.bootstrap || !document.getElementById('legal-modal')) return;
                event.preventDefault();
                event.stopPropagation();
                $('#legal-modal').data('legal-section', $(this).data('legal-section') || 'service-terms');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('legal-modal')).show();
            });
            $('#legal-modal').on('shown.bs.modal', function () {
                var sectionId = $(this).data('legal-section');
                var section = sectionId ? document.getElementById(sectionId) : null;
                var body = this.querySelector('.legal-modal-body');
                if (section && body) body.scrollTop = Math.max(0, section.offsetTop - body.offsetTop - 18);
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
