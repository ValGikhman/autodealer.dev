@model autodealer.dev.Models.AdminLoginViewModel
@{ ViewBag.Title = "Administrator sign in"; ViewBag.BodyClass = "account-page login-page admin-login-page"; }
<section class="page-hero account-page-hero"><div class="shell">
    <div class="account-intro">
        <span class="eyebrow">ADMINISTRATION</span>
        <h1>Platform control. Authorized access only.</h1>
        <p>Sign in to review active customers, subscriptions, and API access across the platform.</p>
    </div></div></section>
<section class="section light-section account-content-section"><div class="shell account-form-shell">
    <div class="form-card login-card">
        <span class="form-step">ADMIN SIGN IN</span>
        <h2>Open the control room</h2>
        @using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { @class = "account-form", autocomplete = "on" })) {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })
            <div class="form-field">
                @Html.LabelFor(m => m.UserId)
                @Html.TextBoxFor(m => m.UserId, new { placeholder = "Administrator user ID", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.UserId)
            </div>
            <div class="form-field">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { placeholder = "Administrator password", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password)
            </div>
            <label class="check-field remember-field">@Html.CheckBoxFor(m => m.RememberMe)<span>Keep me signed in on this device</span></label>
            <button class="button button-primary submit-button" type="submit">Sign in as administrator</button>
            <small class="form-secure">Role-protected session &middot; Password verified using PBKDF2</small>
        }
    </div>
</div></section>
