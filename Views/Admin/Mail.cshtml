@{
    ViewBag.Title = "Mail";
    ViewBag.BodyClass = "dashboard-page admin-dashboard-page";
    var inboxFromAddress = (System.Configuration.ConfigurationManager.AppSettings["Smtp:From"] ?? string.Empty).Trim();
}

@section head {
    @Styles.Render("~/bundles/admin-css")
}

<section class="site-hero page-hero dashboard-hero admin-hero">
    <div class="shell site-hero-shell">
        <div class="hero-copy">
            <span class="eyebrow">ADMIN CONTROL ROOM</span>
            <h1>Sales inbox.</h1>
            <p>Messages received by sales@autodealer.dev</p>
        </div>
    </div>
</section>

<section class="section light-section dashboard-section">
    <div class="shell">
        <div class="section-heading">
            <span class="eyebrow">MAIL</span>
            <h2>Inbox messages.</h2>
            <span class="status-badge" id="admin-inbox-page-count">Loading inbox</span>
        </div>
        <section class="admin-customer-panel dashboard-grid-panel" aria-labelledby="admin-inbox-grid-title">
            <div class="admin-table-heading">
                <div>
                    <span class="eyebrow">SALES@AUTODEALER.DEV</span>
                    <h2 id="admin-inbox-grid-title">Inbox</h2>
                </div>
                <div class="customer-subgrid-heading-actions">
                    <button type="button" class="customer-api-issue admin-create-button customer-subgrid-create-button" id="admin-inbox-new-email">
                        <svg class="admin-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <use href="#icon-mail"></use>
                        </svg>
                        <span>New email</span>
                    </button>
                    <span id="admin-inbox-total-count">Loading messages</span>
                </div>
            </div>
            <div class="dashboard-key-issue-error admin-inbox-error" id="admin-inbox-error" role="alert" hidden></div>
            <div id="admin-mail-grid"
                 class="admin-pep-grid"
                 data-url="@Url.Action("InboxGridData", "Admin")"
                 data-message-url="@Url.Action("InboxMessage", "Admin")"
                 data-delete-url="@Url.Action("DeleteInboxMessage", "Admin")"
                 data-send-url="@Url.Action("SendInboxEmail", "Admin")">
            </div>
        </section>
    </div>
</section>

<div class="dashboard-antiforgery" hidden>@Html.AntiForgeryToken()</div>

<div class="modal fade dashboard-record-modal dashboard-new-email-modal" id="admin-inbox-compose-modal" tabindex="-1" aria-labelledby="admin-inbox-compose-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" id="admin-inbox-compose-form">
            <div class="modal-header dashboard-record-header">
                <div>
                    <span class="dashboard-record-kicker">SALES EMAIL</span>
                    <h2 class="modal-title" id="admin-inbox-compose-title">New email</h2>
                    <p>Compose a message from the sales inbox.</p>
                </div>
                <button type="button" class="btn-close dashboard-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7 7l10 10M17 7L7 17" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="dashboard-subgrid-edit-fields new-email-address-fields">
                    <div class="dashboard-edit-field">
                        <label for="admin-inbox-compose-to">To</label>
                        <input id="admin-inbox-compose-to" name="To" type="email" maxlength="254" required autocomplete="off" />
                    </div>
                    <div class="dashboard-edit-field dashboard-edit-field-readonly">
                        <label for="admin-inbox-compose-from">From</label>
                        <input id="admin-inbox-compose-from" name="From" type="email" value="@inboxFromAddress" maxlength="254" required readonly />
                    </div>
                    <div class="dashboard-edit-field dashboard-edit-field-wide">
                        <label for="admin-inbox-compose-subject">Subject</label>
                        <input id="admin-inbox-compose-subject" name="Subject" type="text" maxlength="200" required autocomplete="off" />
                    </div>
                </div>
                <textarea id="admin-inbox-compose-body" name="Body" aria-label="Email body"></textarea>
                <div class="dashboard-key-issue-error" id="admin-inbox-compose-error" role="alert" hidden></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary admin-modal-cancel" data-bs-dismiss="modal" aria-label="Cancel" title="Cancel">
                    <svg class="admin-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 7l10 10M17 7 7 17" />
                    </svg>
                    <span>Cancel</span>
                </button>
                <button type="submit" class="customer-api-issue admin-create-button" id="admin-inbox-compose-submit">
                    <svg class="admin-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <use href="#icon-mail"></use>
                    </svg>
                    <span>Send email</span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade dashboard-record-modal dashboard-email-modal admin-mail-preview-modal" id="admin-mail-preview-modal" tabindex="-1" aria-labelledby="admin-mail-preview-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header dashboard-record-header">
                <div>
                    <span class="dashboard-record-kicker">INBOX MESSAGE</span>
                    <h2 class="modal-title" id="admin-mail-preview-title">Email message</h2>
                    <p id="admin-mail-preview-subtitle">Loading message</p>
                </div>
                <button type="button" class="btn-close dashboard-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7 7l10 10M17 7L7 17" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <section class="dashboard-email-preview">
                    <iframe id="admin-mail-preview-frame" sandbox="" referrerpolicy="no-referrer" title="Inbox email preview"></iframe>
                </section>
                <div class="dashboard-key-issue-error admin-inbox-preview-error" id="admin-inbox-preview-error" role="alert" hidden></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="customer-delete-action admin-mail-delete-open" id="admin-mail-delete-open" aria-label="Delete inbox message" title="Delete inbox message" disabled>
                    <svg aria-hidden="true">
                        <use href="#icon-trash"></use>
                    </svg>
                </button>
                <button type="button" class="btn btn-secondary dashboard-modal-done" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade dashboard-record-modal dashboard-client-delete-modal" id="admin-mail-delete-modal" tabindex="-1" aria-labelledby="admin-mail-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="admin-mail-delete-form">
            <div class="modal-header dashboard-record-header">
                <div>
                    <span class="dashboard-record-kicker">MOVE TO TRASH</span>
                    <h2 class="modal-title" id="admin-mail-delete-title">Delete this message?</h2>
                    <p>You can recover it later from the IONOS Trash folder.</p>
                </div>
                <button type="button" class="btn-close dashboard-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7 7l10 10M17 7L7 17" />
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="dashboard-client-delete-summary">
                    <strong id="admin-mail-delete-subject">Selected message</strong>
                    <span id="admin-mail-delete-detail"></span>
                </div>
                <div class="dashboard-key-issue-error" id="admin-mail-delete-error" role="alert" hidden></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="dashboard-modal-done" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="dashboard-client-delete-submit" id="admin-mail-delete-submit">Move to Trash</button>
            </div>
        </form>
    </div>
</div>

<script type="text/x-pepgrid-template" id="admin-inbox-actions-template">
    <div class="customer-email-actions">
        <button type="button" data-email-action="view" aria-label="View inbox message" title="View inbox message">
            <svg class="admin-action-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                <circle cx="12" cy="12" r="2.75"></circle>
            </svg>
        </button>
        <button type="button" class="customer-delete-action admin-inbox-delete-action" data-email-action="delete" aria-label="Delete inbox message" title="Delete inbox message">
            <svg aria-hidden="true">
                <use href="#icon-trash"></use>
            </svg>
        </button>
    </div>
</script>

@section scripts {
    @Scripts.Render("~/bundles/admin-dashboard")
}
