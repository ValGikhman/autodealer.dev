@model autodealer.dev.Models.AdminDashboardViewModel
@{ ViewBag.Title = "Customers"; ViewBag.BodyClass = "dashboard-page admin-dashboard-page"; }

@section head {
    @Styles.Render("~/bundles/admin-css")
}

<section class="site-hero page-hero dashboard-hero admin-hero">
    <div class="shell site-hero-shell">
        <div class="hero-copy">
    <span class="eyebrow">ADMIN CONTROL ROOM</span>
    <h1>@Model.CustomerFilterTitle.</h1>
    <p>@Model.Customers.Count matching of @Model.TotalCustomers registered accounts</p>
</div>
</div>
</section>
<section class="section light-section dashboard-section">
    <div class="shell">
    <div class="section-heading">
        <span class="eyebrow">CUSTOMER DIRECTORY</span>
        <h2>Dealer accounts.</h2>
        <span class="status-badge" id="customer-filter-count">@Model.Customers.Count matching</span>
    </div>
    <section class="admin-customer-panel dashboard-grid-panel" aria-labelledby="customer-grid-title">
        <div class="admin-table-heading">
            <div>
                <span class="eyebrow">@Model.CustomerFilterTitle</span>
                <h2 id="customer-grid-title">Dealer accounts</h2>
            </div>
            <div class="customer-directory-actions">
                @if (Model.CustomerFilter == "all") {
                    <button type="button" class="admin-create-button admin-bulk-delete" id="delete-selected-customers" disabled hidden>
                        <svg class="admin-action-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                            <path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 4v5m4-5v5"></path>
                        </svg>
                        <span>Delete selected (0)</span>
                    </button>
                }
                <label for="customer-filter">Show</label>
                <select id="customer-filter" data-url="@Url.Action("Customers", "Admin")">
                    @foreach (var option in new[] { new { Value = "active", Text = "Active customers" }, new { Value = "all", Text = "Total customers" }, new { Value = "trialing", Text = "Trialing" }, new { Value = "api-keys", Text = "Active API keys" } }) {
                        <option value="@option.Value" selected="@(Model.CustomerFilter == option.Value)">@option.Text</option>
                    }
                </select>

            </div>
        </div>
        <div id="customer-grid" class="admin-pep-grid" data-url="@Url.Action("CustomerGridData", "Admin", new { filter = Model.CustomerFilter })" data-bulk-delete-url="@Url.Action("DeleteClients", "Admin")" data-allow-bulk-delete="@(Model.CustomerFilter == "all" ? "true" : "false")" data-email-url="@Url.Action("CustomerEmailGridData", "Admin")" data-send-email-url="@Url.Action("SendCustomerEmail", "Admin")" data-account-detail-url="@Url.Action("CustomerAccountDetailData", "Admin")" data-issue-key-url="@Url.Action("IssueApiKey", "Admin")" data-new-client-url="@Url.Action("NewClient", "Admin")" data-edit-client-url="@Url.Action("EditClient", "Admin")" data-delete-client-url="@Url.Action("DeleteClient", "Admin")" data-edit-api-key-url="@Url.Action("EditApiKey", "Admin")" data-new-subscription-url="@Url.Action("NewSubscription", "Admin")" data-edit-subscription-url="@Url.Action("EditSubscription", "Admin")">
        </div>
    </section>
</div>
</section>

@Html.Partial("_AdminRecordModal")

@if (Model.CustomerFilter == "all") {
    @Html.Partial("_AdminDeleteConfirmationModal", new autodealer.dev.Models.AdminDeleteConfirmationViewModel {
        IdPrefix = "delete-customers",
        Title = "Delete selected customers?",
        Warning = "This permanently deletes every selected account, credentials, API keys, subscriptions, payment profiles, usage records, and email history.",
        Confirmation = "I understand that all records for the selected customers will be permanently deleted.",
        KeepButtonText = "Keep customers",
        DeleteButtonText = "Delete selected customers"
    })
}

@section scripts {
    @Scripts.Render("~/bundles/admin-dashboard")
}
