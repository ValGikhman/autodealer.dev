@{ ViewBag.Title = "Dealer solutions"; }
<section class="site-hero page-hero"><div class="shell site-hero-shell narrow"><div class="hero-copy"><span class="eyebrow">DEALER SOLUTIONS</span><h1>One platform. Every touchpoint.</h1><p>Vehicle data, live inventory, and customer experiences on one platform.</p></div></div></section>
<section class="section light-section"><div class="shell product-list solutions-product-grid">
    <article><div><div class="title-with-icon"><span class="color-icon icon-blue" aria-hidden="true"><svg><use href="#icon-vehicle-data"></use></svg></span><h2>VIN Decode API</h2></div><p>Transform a VIN into complete automotive intelligence: matching styles, specifications, equipment, pricing, engines, transmissions, and evolving provider records.</p><ul class="check-list"><li>JSON, XML, and styled HTML</li><li>Every matching US-market style</li><li>Server-side data protection</li></ul><a class="button site-cta" href="@Url.Action("VinDecoder")"><span>See VIN Decode API</span><i aria-hidden="true">&rarr;</i></a></div><a class="product-visual code-visual html-api-visual" href="@Url.Action("VinDecoder")" aria-label="Try the rendered HTML VIN Decode API response"><img class="solutions-product-image" src="@Url.Content("~/Content/images/vin-html-api-promo-v2.png")" width="420" height="280" loading="lazy" decoding="async" alt="Responsive HTML VIN Decode API report displayed on laptop and mobile devices" /></a></article>
    <article><div><div class="title-with-icon"><span class="color-icon icon-teal" aria-hidden="true"><svg><use href="#icon-browser"></use></svg></span><h2>Dealer Website</h2></div><p>Build a fast, coherent dealer website around live inventory, transparent pricing, financing, and customer conversion.</p><ul class="check-list"><li>Deep vehicle search and SEO pages</li><li>Credit, contact, and test-drive leads</li><li>Hours, staff, reviews, and multilingual content</li></ul><a class="button site-cta" href="@Url.Action("DigitalShowroom")"><span>See Dealer Website</span><i aria-hidden="true">&rarr;</i></a></div><a class="product-visual site-visual showroom-ad-visual" href="@Url.Action("DigitalShowroom")" aria-label="See the V-TEC Solution digital showroom"><img class="solutions-product-image" src="@Url.Content("~/Content/images/vtec-dealer-showroom-ad-v2.png")" width="420" height="280" loading="lazy" decoding="async" alt="V-TEC Solution dealer inventory website presented on desktop and mobile devices" /></a></article>
</div></section>
