@model autodealer.dev.Models.DealerDemoRequestViewModel
@{ ViewBag.Title = "Demo requested"; }
<section class="site-hero page-hero"><div class="shell site-hero-shell"><div class="hero-copy"><span class="eyebrow">REQUEST RECEIVED</span><h1>Your demo request is received.</h1><p>Request received for @Model.BusinessName. We&rsquo;ll contact @Model.ContactName soon.</p></div></div></section>
<section class="section light-section account-content-section"><div class="shell account-form-shell">
    <div class="success-card"><div class="success-mark">&#10003;</div><h2>We&rsquo;ll make the conversation useful.</h2><p>Your dealership details have been delivered to our team. We will review your goals before reaching out.</p><div class="button-row centered-row"><a class="button button-primary" href="@Url.Action("DigitalShowroom", "Solutions")">Explore the dealer website</a><a class="button button-outline" href="@Url.Action("Index", "Home")">Return home</a></div></div>
</div></section>
