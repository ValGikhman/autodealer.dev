      <Column Name="UpdatedUtc" Type="System.DateTime" DbType="DateTime2(3) NOT NULL" CanBeNull="false" />
      <Column Name="RowVersion" Type="System.Data.Linq.Binary" DbType="rowversion NOT NULL" CanBeNull="false" IsVersion="true" />
      <Association Name="FK_ApiKeys_Client" Member="ApiKeys" ThisKey="ClientId" OtherKey="ClientId" Type="ApiKey" DeleteRule="NO ACTION" />
      <Association Name="FK_ApiUsageDaily_Client" Member="ApiUsageDailies" ThisKey="ClientId" OtherKey="ClientId" Type="ApiUsageDaily" DeleteRule="NO ACTION" />
      <Association Name="FK_ApiUsageLog_Client" Member="ApiUsageLogs" ThisKey="ClientId" OtherKey="ClientId" Type="ApiUsageLog" DeleteRule="NO ACTION" />
      <Association Name="FK_ClientCredentials_Client" Member="ClientCredential" ThisKey="ClientId" OtherKey="ClientId" Type="ClientCredential" Cardinality="One" DeleteRule="CASCADE" />
      <Association Name="FK_PaymentProfiles_Client" Member="PaymentProfiles" ThisKey="ClientId" OtherKey="ClientId" Type="PaymentProfile" DeleteRule="CASCADE" />
      <Association Name="FK_Subscriptions_Client" Member="Subscriptions" ThisKey="ClientId" OtherKey="ClientId" Type="Subscription" DeleteRule="NO ACTION" />
    </Type>
  </Table>
  <Table Name="dbo.PaymentProfiles" Member="PaymentProfiles">
    <Type Name="PaymentProfile">
