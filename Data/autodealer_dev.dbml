<?xml version="1.0" encoding="utf-8"?>
<Database Name="AUTODEALER.DEV" EntityNamespace="autodealer.dev.Data" ContextNamespace="autodealer.dev.Data" Class="AutoDealerDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.ApiKeys" Member="ApiKeys">
    <Type Name="ApiKey">
      <Column Name="ApiKeyId" Type="System.Int64" DbType="BigInt NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="ClientId" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Column Name="SubscriptionId" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Column Name="KeyId" Type="System.String" DbType="VarChar(64) NOT NULL" CanBeNull="false" />
      <Column Name="SecretHash" Type="System.Data.Linq.Binary" DbType="Binary(32) NOT NULL" CanBeNull="false" />
      <Column Name="KeyPrefix" Type="System.String" DbType="VarChar(20) NOT NULL" CanBeNull="false" />
      <Column Name="Name" Type="System.String" DbType="NVarChar(80) NOT NULL" CanBeNull="false" />
      <Column Name="Scopes" Type="System.String" DbType="VarChar(500) NOT NULL" CanBeNull="false" />
      <Column Name="Status" Type="System.String" DbType="VarChar(20) NOT NULL" CanBeNull="false" />
      <Column Name="LastUsedUtc" Type="System.DateTime" DbType="DateTime2(3)" CanBeNull="true" />
      <Column Name="ExpiresUtc" Type="System.DateTime" DbType="DateTime2(3)" CanBeNull="true" />
      <Column Name="RevokedUtc" Type="System.DateTime" DbType="DateTime2(3)" CanBeNull="true" />
      <Column Name="CreatedUtc" Type="System.DateTime" DbType="DateTime2(3) NOT NULL" CanBeNull="false" />
      <Association Name="FK_ApiKeys_Client" Member="Client" ThisKey="ClientId" OtherKey="ClientId" Type="Client" IsForeignKey="true" />
      <Association Name="FK_ApiKeys_Subscription" Member="Subscription" ThisKey="SubscriptionId" OtherKey="SubscriptionId" Type="Subscription" IsForeignKey="true" />
      <Association Name="FK_ApiUsageLog_Key" Member="ApiUsageLogs" ThisKey="ApiKeyId" OtherKey="ApiKeyId" Type="ApiUsageLog" DeleteRule="NO ACTION" />
    </Type>
  </Table>
  <Table Name="dbo.ApiUsageDaily" Member="ApiUsageDailies">
    <Type Name="ApiUsageDaily">
      <Column Name="UsageDate" Type="System.DateTime" DbType="Date NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="ClientId" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Column Name="SubscriptionId" Type="System.Int64" DbType="BigInt NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="RequestCount" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="ErrorCount" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="TotalDurationMs" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Association Name="FK_ApiUsageDaily_Client" Member="Client" ThisKey="ClientId" OtherKey="ClientId" Type="Client" IsForeignKey="true" />
      <Association Name="FK_ApiUsageDaily_Subscription" Member="Subscription" ThisKey="SubscriptionId" OtherKey="SubscriptionId" Type="Subscription" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.ApiUsageLog" Member="ApiUsageLogs">
    <Type Name="ApiUsageLog">
      <Column Name="RequestId" Type="System.Guid" DbType="UniqueIdentifier NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="ApiKeyId" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Column Name="ClientId" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Column Name="SubscriptionId" Type="System.Int64" DbType="BigInt NOT NULL" CanBeNull="false" />
      <Column Name="Endpoint" Type="System.String" DbType="NVarChar(300) NOT NULL" CanBeNull="false" />
      <Column Name="HttpMethod" Type="System.String" DbType="VarChar(10) NOT NULL" CanBeNull="false" />
      <Column Name="StatusCode" Type="System.Int16" DbType="SmallInt" CanBeNull="true" />
      <Column Name="DurationMs" Type="System.Int32" DbType="Int" CanBeNull="true" />
      <Column Name="IpAddress" Type="System.String" DbType="VarChar(64)" CanBeNull="true" />
      <Column Name="UserAgent" Type="System.String" DbType="NVarChar(300)" CanBeNull="true" />
      <Column Name="RequestedUtc" Type="System.DateTime" DbType="DateTime2(3) NOT NULL" CanBeNull="false" />
      <Column Name="CompletedUtc" Type="System.DateTime" DbType="DateTime2(3)" CanBeNull="true" />
      <Association Name="FK_ApiUsageLog_Client" Member="Client" ThisKey="ClientId" OtherKey="ClientId" Type="Client" IsForeignKey="true" />
      <Association Name="FK_ApiUsageLog_Key" Member="ApiKey" ThisKey="ApiKeyId" OtherKey="ApiKeyId" Type="ApiKey" IsForeignKey="true" />
      <Association Name="FK_ApiUsageLog_Subscription" Member="Subscription" ThisKey="SubscriptionId" OtherKey="SubscriptionId" Type="Subscription" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.ClientCredentials" Member="ClientCredentials">
    <Type Name="ClientCredential">
      <Column Name="ClientId" Type="System.Int64" DbType="BigInt NOT NULL" IsPrimaryKey="true" CanBeNull="false" />
      <Column Name="PasswordHash" Type="System.Data.Linq.Binary" DbType="VarBinary(64) NOT NULL" CanBeNull="false" />
