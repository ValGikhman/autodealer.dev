    <add key="DataOne:SharedConfigPath" value="..\GTX\Web.config" />
    <!-- Set true after running Database/001_AutoDealerPlatform.sql. -->
    <add key="ApiSecurity:Enabled" value="false" />
    <!-- Public playground credential. It is restricted to five unique VINs per client per 24 hours. -->
